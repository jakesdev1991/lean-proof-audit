{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lean-proof-audit/contract/conformance-1.json",
  "title": "Vault conformance result (lean-audit-vault/1)",
  "type": "object",
  "required": ["contract_version", "generated_at", "lean", "probes", "capabilities", "summary", "compatible"],
  "properties": {
    "contract_version": { "const": "lean-audit-vault/1" },
    "generated_at": { "type": "string" },
    "project": { "type": ["string", "null"] },
    "lean": {
      "type": "object",
      "required": ["path", "version"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "capability", "required", "observed", "detail", "description"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["ok", "fail", "skipped"] },
          "capability": { "type": "string" },
          "required": { "type": "boolean" },
          "observed": { "type": "string" },
          "detail": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "summary": {
      "type": "object",
      "required": ["ok", "failed", "skipped", "required_failed"],
      "properties": {
        "ok": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "required_failed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compatible": { "type": "boolean" },
    "error": { "type": "string" }
  }
}
