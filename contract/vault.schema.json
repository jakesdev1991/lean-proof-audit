{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lean-proof-audit/contract/vault-1.json",
  "title": "Vault manifest (lean-audit-vault/1)",
  "type": "object",
  "required": ["contract_version", "lean", "project"],
  "additionalProperties": true,
  "properties": {
    "contract_version": { "const": "lean-audit-vault/1" },
    "name": { "type": "string" },
    "repo": { "type": "string" },
    "commit": { "type": "string" },
    "generated_at": { "type": "string" },
    "lean": {
      "type": "object",
      "properties": {
        "path": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "default": "." },
        "build_command": { "type": ["string", "null"] },
        "has_mathlib": { "type": "boolean", "default": false },
        "packages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "expect": { "type": "string", "enum": ["pass", "warn", "fail", "inconclusive"] },
          "note": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "conformance": { "type": "string" }
  }
}
